- unless record.class.reflect_on_attachment(attachment).macro == :has_many_attached
  .field.row
    = f.label attachment
    .col= f.file_field attachment, class: 'form-control', accept: 'image/*'
    - if record.send(attachment).attached?
      .col-auto.d-flex.align-items-start.border.rounded.p-2
        = image_tag record.send(attachment).variant(resize_to_limit: [200, 200])
        = link_to data_attachment_path(record.send(attachment).attachment), data: { turbo_method: :delete }, class: 'btn btn-danger btn-sm ms-1' do
          %i.bi.bi-x-lg
