%tr{id: dom_id(record)}
  %td= render 'data/buttons', record:
  - attributes = record.attributes
  - headers.each do |header|
    - attribute = header.to_s
    - value = attributes[attribute] if attributes.key?(attribute) # Table column
    - value = record.public_send(header) unless attributes.key?(attribute) # Model method
    %td
      - text = show_value(attribute, value)
      - if text.is_a?(String) && text.length > max_index_cell_length
        %span{ title: text }= truncate(text, length: max_index_cell_length)
      - else
        = text